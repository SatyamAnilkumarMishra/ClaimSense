# ClaimSense Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env!

# Runtime & Mode
BACKEND_MODE=inprocess               # Options: inprocess (monolithic Streamlit), http (FastAPI REST service)
OFFLINE_MODE=false                   # Set to true to force offline snapshot mode

# Databricks (Free Edition / Serverless)
DATABRICKS_HOST=https://dbc-xxxxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_personal_access_token_here
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxx
DATABRICKS_CATALOG=workspace         # Discovered catalog name (e.g., workspace, main, or hive_metastore)
DATABRICKS_SCHEMA=claimsense
DATABRICKS_VOLUME=landing_zone
DATABRICKS_JOB_ID=                   # Populated once Databricks Workflow Job is created

# Groq LLM Provider
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# FastAPI Service & Security
FASTAPI_API_KEY=claimsense_local_dev_secret_key_change_in_prod
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Snowflake (Optional - Stage 7)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CLAIMSENSE_DB
SNOWFLAKE_SCHEMA=MART
SNOWFLAKE_ROLE=ACCOUNTADMIN
