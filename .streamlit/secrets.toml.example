# Streamlit Community Cloud Secrets Template
# Copy this content into your Streamlit Cloud App Settings -> Secrets

BACKEND_MODE = "inprocess"
OFFLINE_MODE = "false"

# Databricks Credentials
DATABRICKS_HOST = "https://dbc-xxxxxx.cloud.databricks.com"
DATABRICKS_TOKEN = "dapi_your_token_here"
DATABRICKS_HTTP_PATH = "/sql/1.0/warehouses/xxxxxx"
DATABRICKS_CATALOG = "workspace"
DATABRICKS_SCHEMA = "claimsense"
DATABRICKS_VOLUME = "landing_zone"
DATABRICKS_JOB_ID = ""

# Groq API Key
GROQ_API_KEY = "gsk_your_groq_api_key_here"
GROQ_FAST_MODEL = "llama-3.1-8b-instant"
GROQ_REASONING_MODEL = "llama-3.3-70b-versatile"

# Optional FastAPI / Snowflake
FASTAPI_API_KEY = "claimsense_secret_key"
